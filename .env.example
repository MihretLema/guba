# Set an existing GUBA PostgreSQL database, or use PG_ADMIN_URL for initial creation.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/guba_admin"
# PG_ADMIN_URL="postgresql://USER:PASSWORD@localhost:5432/postgres"
ADMIN_INITIAL_EMAIL="mihretlemabelete@gmail.com"
# Optional: provide an initial password of at least 12 characters before first setup.
# ADMIN_INITIAL_PASSWORD=""
# Enable ONLY behind hosting that strips client-supplied identity headers and injects trusted identity.
TRUST_CHATGPT_AUTH_HEADERS=false
ADMIN_EMAILS="mihretlemabelete@gmail.com"
